#!/bin/sh
# Start Brax Device Toolkit from a source checkout on Linux.
set -eu
here=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
python="$here/.venv/bin/python"
if [ ! -x "$python" ]; then
    echo "Virtual environment not found. Run: $here/linux/setup.sh" >&2
    exit 1
fi
exec "$python" "$here/repair_app.py" "$@"
